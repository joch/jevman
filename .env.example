# Option A — play with your own Opper key (local dev only; ignored when OPPER_REDIRECT_URI is https
# unless JEV_ALLOW_DEV_KEY=1, because it would pay for every signed-out visitor)
OPPER_API_KEY=
OPPER_BASE_URL=https://api.opper.ai

# Option B — Login with Opper (players pay with their own Opper wallet)
OPPER_CLIENT_ID=
OPPER_CLIENT_SECRET=
OPPER_REDIRECT_URI=http://localhost:5173/auth/callback
# 32+ random characters, e.g. `openssl rand -hex 32` (required when OPPER_REDIRECT_URI is https)
SESSION_SECRET=
